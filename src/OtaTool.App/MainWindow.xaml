                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="EcoLink 日志分析" />
                                <TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,6,0,22" Text="选择目录后先确认本次分析清单；分析器只读取清单中的日志。" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="导入日志目录" />
                                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox IsReadOnly="True" Text="{Binding LogDirectory, Mode=OneWay}" ToolTip="通过右侧浏览按钮重新选择目录" /><Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="浏览…" Command="{Binding BrowseLogDirectoryCommand}" /></Grid>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,18,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="本次分析日志" />
                                <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource MutedInkBrush}" Text="{Binding ImportedLogFilesSummary}" />
                            </Grid>
                            <Border Grid.Row="2" MinHeight="58" Background="#F8FAFD" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding ImportedLogFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="10,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <Border Padding="7,3" VerticalAlignment="Center" Background="#E9F0FF" CornerRadius="4"><TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#2570E8" Text="LOG" /></Border>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" />
                                                            <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource MutedInkBrush}" Text="{Binding Detail}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="4" MinHeight="28" Height="28" Padding="10,3" VerticalAlignment="Center" Style="{StaticResource QuietButton}" Content="删除" Command="{Binding DataContext.RemoveImportedLogFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="仅从本次分析列表删除，不删除磁盘源文件" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                <TextBlock FontSize="11" Foreground="{StaticResource MutedInkBrush}" Text="删除只影响本次分析清单，不会删除磁盘源文件。循环日志会按全部 SID 分轮解析；单次日志按唯一 SID 解析。" TextWrapping="Wrap" />
                                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Content="分析列表日志" Command="{Binding AnalyzeLogsCommand}" IsEnabled="{Binding HasImportedLogFiles}" />
                                <TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,8,0,0" Text="{Binding LogAnalysisStatus}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="日志分析报告" />
                                    <TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,6,0,0" Text="基于升级闭环、目标完成度、传输可靠性和时延表现进行 100 分制评估。" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Row="1" Margin="0,16,0,16" Padding="16" Background="#F5F8FC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock FontSize="36" FontWeight="Bold" Foreground="{Binding LogAnalysisQualityColor}" Text="{Binding LogAnalysisQualityScore}" />
                                            <TextBlock Margin="4,13,0,0" FontSize="13" Foreground="{StaticResource MutedInkBrush}" Text="/ 100" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{Binding LogAnalysisQualityColor}" Text="{Binding LogAnalysisQualityGrade}" />
                                            <TextBlock Margin="0,5,0,0" FontSize="13" Foreground="{StaticResource MutedInkBrush}" Text="{Binding LogAnalysisQualitySummary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="2" Padding="18" Background="#F8FAFD" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                    <ItemsControl ItemsSource="{Binding LogAnalysisResultLines, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontFamily="Microsoft YaHei UI" FontSize="14" LineHeight="24" Text="{Binding Text}" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsProblem}" Value="True"><Setter Property="Foreground" Value="#C53333" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsHeader}" Value="True"><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </Grid>

                <!-- 历史报告 -->
                <Grid Visibility="{Binding ReportsPageVisibility}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border Background="#EEF2F8" CornerRadius="6" Padding="3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="ReportScopeTabs" Style="{StaticResource ModeRadio}" Content="当前报告"
                                                 IsChecked="{Binding IsShowingActiveReports, Mode=OneWay}"
                                                 Command="{Binding ShowActiveReportsCommand}" />
                                    <RadioButton GroupName="ReportScopeTabs" Style="{StaticResource ModeRadio}" Content="归档报告"
                                                 IsChecked="{Binding IsShowingArchivedReports, Mode=OneWay}"
                                                 Command="{Binding ShowArchivedReportsCommand}" />
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding ActiveReportsHeader}" />
                                <Button Grid.Column="1" Style="{StaticResource QuietButton}" Content="刷新" Command="{Binding LoadReportsCommand}" />
                            </Grid>
                            <TextBlock Grid.Row="2" Margin="0,6,0,14" FontSize="12" Foreground="{StaticResource MutedInkBrush}" Text="{Binding ReportScopeDescription}" TextWrapping="Wrap" />
                            <ListBox Grid.Row="3" ItemsSource="{Binding RecentReports}" SelectedItem="{Binding SelectedReport, Mode=TwoWay}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.InputBindings><KeyBinding Key="Delete" Command="{Binding DeleteReportCommand}" /></ListBox.InputBindings>
                                <ListBox.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="查看详细报告" Command="{Binding OpenReportCommand}" />
                                        <MenuItem Header="归档 / 恢复" Command="{Binding ToggleReportArchiveCommand}" />
                                        <Separator />
                                        <MenuItem Header="删除报告" Command="{Binding DeleteReportCommand}" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,10" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding StartedAt}" />
                                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource MutedInkBrush}">
                                                    <TextBlock.Inlines><Run Text="{Binding Mode, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DeviceType, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding State, Mode=OneWay}" /></TextBlock.Inlines>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="报告总结" />
                                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource MutedInkBrush}" Text="单击左侧报告可查看任务摘要与阶段时间线；详细报告仅在需要时打开。" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedInkBrush}" Text="请选择一条报告" Visibility="{Binding ReportSelectionHintVisibility}" />
                            <Grid Grid.Row="1" Margin="0,16,0,0" Visibility="{Binding SelectedReportVisibility}">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Foreground="{StaticResource MutedInkBrush}" Text="开始时间" /><TextBlock Grid.Column="1" Text="{Binding SelectedReport.StartedAt}" />
                                    <TextBlock Grid.Row="1" Foreground="{StaticResource MutedInkBrush}" Text="模式 / 类型" /><TextBlock Grid.Row="1" Grid.Column="1"><Run Text="{Binding SelectedReport.Mode, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SelectedReport.DeviceType, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Grid.Row="2" Foreground="{StaticResource MutedInkBrush}" Text="版本" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedReport.Version}" />
                                    <TextBlock Grid.Row="3" Foreground="{StaticResource MutedInkBrush}" Text="最终状态" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedReport.State}" />
                                    <TextBlock Grid.Row="4" Foreground="{StaticResource MutedInkBrush}" Text="总耗时" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedReport.Duration}" />
                                </Grid>
                                <Border Grid.Row="2" Margin="0,18,0,0" Background="#F8FAFD" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Border Padding="12,9" Background="#F2F6FB">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*" /><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="1.7*" /></Grid.ColumnDefinitions>
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="阶段" />
                                                <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Text="状态" />
                                                <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" Text="开始时间" />
                                                <TextBlock Grid.Column="3" FontSize="12" FontWeight="SemiBold" Text="耗时" />
                                                <TextBlock Grid.Column="4" FontSize="12" FontWeight="SemiBold" Text="方向 / 原因" />
                                            </Grid>
                                        </Border>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding SelectedReport.StageTimeline, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="12,9" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*" /><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="1.7*" /></Grid.ColumnDefinitions>
                                                                <TextBlock FontSize="12" Text="{Binding Stage, Mode=OneWay}" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="1" FontSize="12" Foreground="{Binding StateColor, Mode=OneWay}" Text="{Binding State, Mode=OneWay}" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" FontSize="12" Text="{Binding StartTime, Mode=OneWay}" />
                                                                <TextBlock Grid.Column="3" FontSize="12" Text="{Binding Duration, Mode=OneWay}" />
                                                                <TextBlock Grid.Column="4" FontSize="12" Foreground="{StaticResource MutedInkBrush}" Text="{Binding DirectionOrReason, Mode=OneWay}" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedInkBrush}" Text="暂无阶段时间线" Visibility="{Binding SelectedReport.StageTimelineEmptyVisibility}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="3" Margin="0,16,0,0" Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}" Content="查看详细报告" Command="{Binding OpenReportCommand}" />
                                    <Button Margin="8,0,0,0" Style="{StaticResource QuietButton}" Content="{Binding SelectedReport.ArchiveButtonText}" Command="{Binding ToggleReportArchiveCommand}" />
                                    <Button Margin="8,0,0,0" Style="{StaticResource QuietButton}" Content="删除" Command="{Binding DeleteReportCommand}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 系统设置 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SettingsPageVisibility}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock FontSize="20" FontWeight="SemiBold" Text="持久化与凭据" /><TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,6,0,18" Text="普通设置保存到 JSON；MQTT/SFTP 密码与私钥口令只保存到 Windows Credential Manager。" TextWrapping="Wrap" /><TextBlock Style="{StaticResource FieldLabel}" Text="SFTP 私钥口令" /><TextBox Margin="0,6,0,0" Text="{Binding SftpPrivateKeyPassphrase, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,16,0,0" FontSize="16" FontWeight="SemiBold" Text="升级前检查" /><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Node Patch 门限（字节）" /><TextBox Margin="0,4,0,0" Text="{Binding NodePatchLimit, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,8,0,0" Style="{StaticResource FieldLabel}" Text="Sync Patch 门限（字节）" /><TextBox Margin="0,4,0,0" Text="{Binding SyncPatchLimit, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,8,0,0" Style="{StaticResource FieldLabel}" Text="发现结果有效期（分钟）" /><TextBox Margin="0,4,0,0" Text="{Binding DiscoveryFreshnessMinutes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="Async Patch 门限（字节）" /><TextBox Margin="0,4,0,0" Text="{Binding AsyncPatchLimit, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,8,0,0" Style="{StaticResource FieldLabel}" Text="Gateway Patch 门限（字节）" /><TextBox Margin="0,4,0,0" Text="{Binding GatewayPatchLimit, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,8,0,0" Style="{StaticResource FieldLabel}" Text="Node 最低 RSSI（dBm）" /><TextBox Margin="0,4,0,0" Text="{Binding MinimumNodeRssi, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid><TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,18,0,0" Text="{Binding SettingsStatus}" TextWrapping="Wrap" /><Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,20,0,0" Content="保存全部设置" Command="{Binding SaveSettingsCommand}" /></StackPanel></Border>
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="在线升级" />
                                    <TextBlock Margin="0,6,0,16" FontSize="12" Foreground="{StaticResource MutedInkBrush}" Text="仅跟随 GitHub 正式版；更新包通过大小与双重 SHA-256 校验后安装。" TextWrapping="Wrap" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="当前版本" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding ApplicationUpdate.CurrentVersion}" />
                                        <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource FieldLabel}" Text="最新版本" /><TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding ApplicationUpdate.LatestVersion}" />
                                        <TextBlock Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource FieldLabel}" Text="构建时间" /><TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Text="{Binding ApplicationUpdate.BuildTime}" />
                                        <TextBlock Grid.Row="3" Margin="0,8,0,0" Style="{StaticResource FieldLabel}" Text="Git 提交" /><TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" FontFamily="Cascadia Mono" Text="{Binding ApplicationUpdate.GitCommit}" />
                                        <TextBlock Grid.Row="4" Margin="0,8,0,0" Style="{StaticResource FieldLabel}" Text="更新通道" /><TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Text="{Binding ApplicationUpdate.UpdateChannel}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="5" Margin="0,8,0,0" Style="{StaticResource FieldLabel}" Text="安装目录" /><TextBlock Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Text="{Binding ApplicationUpdate.InstallDirectory}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="6" Margin="0,8,0,0" Style="{StaticResource FieldLabel}" Text="上次检查" /><TextBlock Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" Text="{Binding ApplicationUpdate.LastCheck}" />
                                    </Grid>
                                    <TextBlock Margin="0,14,0,0" FontSize="12" Foreground="{StaticResource MutedInkBrush}" Text="{Binding ApplicationUpdate.Status}" TextWrapping="Wrap" />
                                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                        <Button MinWidth="126" Style="{StaticResource PrimaryButton}" Content="{Binding ApplicationUpdate.CheckButtonText}" Command="{Binding ApplicationUpdate.CheckNowCommand}" />
                                        <Button MinWidth="96" Margin="8,0,0,0" Style="{StaticResource QuietButton}" Content="{Binding ApplicationUpdate.ActionButtonText}" Command="{Binding ApplicationUpdate.ShowUpdateCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,16,0,0" Style="{StaticResource Card}"><StackPanel><TextBlock FontSize="20" FontWeight="SemiBold" Text="运行约束" /><TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,12,0,0" Text="• 同一工具实例同一时刻只允许一个父 OTA 任务。" /><TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,9,0,0" Text="• 传统模式只支持 Gateway、Sync；不支持日志分析与 cmd=8/9。" TextWrapping="Wrap" /><TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,9,0,0" Text="• EcoLink 模式要求观察到目标 Gateway 上行消息后才允许启动。" TextWrapping="Wrap" /><TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,9,0,0" Text="• 未认证差分引擎禁止生成 Patch，仅允许导入已生成文件。" TextWrapping="Wrap" /></StackPanel></Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="1"
                    Background="#660B1B2E"
                    Visibility="{Binding GlobalDialogVisibility}"
                    Panel.ZIndex="20">
                <Border Width="500"
                        MaxHeight="620"
                        Padding="22"
                        Background="White"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,88,0" VerticalAlignment="Top" FontSize="18" FontWeight="SemiBold" Text="{Binding PatchDialogTitle}" />
                        <Border Grid.Row="0"
                                Width="72"
                                Height="72"
                                Margin="0,-8,-8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderBrush="{Binding DialogResultStampColor}"
                                BorderThickness="3"
                                CornerRadius="36"
                                Opacity="0.9"
                                Visibility="{Binding DialogResultStampVisibility}">
                            <Grid Margin="4">
                                <Border BorderBrush="{Binding DialogResultStampColor}" BorderThickness="1" CornerRadius="30" />
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="19"
                                           FontStyle="Italic"
                                           FontWeight="Bold"
                                           Foreground="{Binding DialogResultStampColor}"
                                           RenderTransformOrigin="0.5,0.5"
                                           Text="{Binding DialogResultStampText}">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="-12" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" Margin="0,14,0,16" MaxHeight="430" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock FontFamily="Cascadia Mono" FontSize="12" Foreground="{StaticResource InkBrush}" Text="{Binding PatchDialogMessage}" TextWrapping="Wrap" />
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource QuietButton}" Content="取消" Command="{Binding CancelPatchDialogCommand}" Visibility="{Binding DialogCancelVisibility}" />
                            <Button Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Content="{Binding PatchDialogConfirmText}" Command="{Binding ConfirmPatchDialogCommand}" IsDefault="{Binding IsGlobalDialogConfirmDefault}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <Border x:Name="GlobalLogBorder" Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,8,28,6">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="GlobalLogTitleText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="全局运行日志（仅保留本次运行最近 300 行，向上滚动暂停，滚回底部自动跟随）" TextTrimming="CharacterEllipsis" ToolTip="向上滚动可暂停查看；滚回底部或按 Enter 后自动跟随最新日志" />
                        <Button Grid.Column="1" Height="24" MinWidth="56" Padding="10,0" Style="{StaticResource QuietButton}" Content="清空" Command="{Binding ClearGlobalLogCommand}" ToolTip="清空当前内存中的全局运行日志" />
                        <Button x:Name="GlobalLogMinimizeButton" Grid.Column="2" Height="24" MinWidth="64" Margin="8,0,0,0" Padding="10,0" Style="{StaticResource QuietButton}" Content="最小化" Click="OnGlobalLogMinimizeClick" ToolTip="收起全局运行日志" />
                    </Grid>
                    <TextBox x:Name="GlobalLogTextBox" Grid.Row="1" Margin="0,5,0,0" Background="White" Foreground="Black" FontFamily="Cascadia Mono" FontSize="11" IsReadOnly="True" VerticalContentAlignment="Top" Text="{Binding GlobalLogText, Mode=OneWay}" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" PreviewMouseWheel="OnGlobalLogPreviewMouseWheel" PreviewKeyDown="OnGlobalLogPreviewKeyDown" TextChanged="OnGlobalLogTextChanged" />
                </Grid>
            </Border>
            <Border x:Name="FooterBorder" Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,0"><DockPanel><TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedInkBrush}" Text="{Binding TaskStatusMessage}" /><TextBlock x:Name="FooterShortcutText" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedInkBrush}" Text="Ctrl+D PATCH 中心  ·  Ctrl+T 升级任务" /></DockPanel></Border>
        </Grid>
    </Grid>
    </Border>
</Window>
