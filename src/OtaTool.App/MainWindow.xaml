                            <Border Margin="0,16,0,0" Background="#FFF6E7" BorderBrush="#F1D7A4" BorderThickness="1" CornerRadius="5" Padding="10" Visibility="{Binding BroadcastTargetVisibility}"><TextBlock FontSize="12" Foreground="{StaticResource AmberBrush}" Text="广播升级不会填写、保存或发送目标 ID。" /></Border>
                            <Border x:Name="CycleUpgradeSettingsPanel" Margin="0,18,0,0" Style="{StaticResource FunctionalPanel}">
