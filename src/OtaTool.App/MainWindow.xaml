                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.8*" />
                                                        <ColumnDefinition Width="1.25*" />
                                                        <ColumnDefinition Width="1.35*" />
                                                        <ColumnDefinition Width="1.1*" />
                                                        <ColumnDefinition Width="1.15*" />
                                                        <ColumnDefinition Width="1.45*" />
