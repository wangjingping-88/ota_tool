<Window x:Class="OtaTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OtaTool.App.Views"
        xmlns:controls="clr-namespace:OtaTool.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title=""
        Width="1560" Height="960" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}"
        WindowStyle="None" ResizeMode="CanResize"
        SizeChanged="OnWindowSizeChanged"
        DpiChanged="OnWindowDpiChanged"
        Loaded="OnLoaded"
        Closed="OnClosed">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#263247" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionRoot" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionRoot" Property="Background" Value="#E8EDF5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionRoot" Property="Background" Value="#D8E0EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5484D" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C93C41" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="PATCH 中心" />
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="升级任务" />
    </Window.InputBindings>
    <Border x:Name="WindowFrame"
            BorderBrush="#AEB8C5"
            SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource NavBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,18,18">
                    <TextBlock Foreground="White" FontSize="20" FontWeight="SemiBold" Text="OTA 测试平台" />
                    <TextBlock Foreground="#9AACC5" FontSize="11" Margin="1,7,0,0" Text="FIRMWARE DELIVERY CONSOLE" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="#27384E" BorderThickness="0,1,0,0" Padding="20,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#28C77B" Margin="0,4,8,0" /><TextBlock Foreground="#DDE9F8" FontSize="12" Text="服务已就绪" /></StackPanel>
                        <TextBlock Foreground="#8195B0" FontSize="11" Margin="16,7,0,0" Text="{Binding ApplicationUpdate.CurrentVersion}" />
                    </StackPanel>
                </Border>
                <ListBox Margin="8,8,8,0" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                         KeyboardNavigation.TabNavigation="Cycle">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="42"><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="18" Height="18" CornerRadius="3" BorderBrush="#A9B8CC" BorderThickness="1" VerticalAlignment="Center"><TextBlock Text="{Binding Index}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,0" /><Setter Property="Margin" Value="0,2" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#C5D1E1" /><Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="5"><ContentPresenter /></Border><ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource NavHoverBrush}" /></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#246BFD" /><Setter Property="Foreground" Value="White" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                            </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="100" /><RowDefinition Height="*" /><RowDefinition x:Name="GlobalLogRow" Height="204" /><RowDefinition x:Name="FooterRow" Height="34" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource CaptionButton}" Content="—" ToolTip="最小化" Click="OnMinimizeClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button ToolTip="最大化/还原" Click="OnToggleMaximizeClick" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                                    <Setter Property="Content" Value="□" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Content" Value="❐" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource CloseCaptionButton}" Content="×" ToolTip="关闭" Click="OnCloseClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>
                    <Grid x:Name="HeaderContentGrid" Grid.Row="1" Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding CurrentPageTitle}" /><TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource MutedInkBrush}" Text="{Binding CurrentPageSubtitle}" /></StackPanel>
                        <Border Grid.Column="1" Background="#F0F3F8" CornerRadius="6" Padding="3" VerticalAlignment="Center" Margin="0,0,18,0"><StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Mode" IsChecked="{Binding IsTraditional, Mode=TwoWay}" Style="{StaticResource ModeRadio}" Content="传统模式" />
                            <RadioButton GroupName="Mode" IsChecked="{Binding IsEcoLink, Mode=TwoWay}" Style="{StaticResource ModeRadio}" Content="EcoLink 模式" />
                        </StackPanel></Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="ContentHostGrid" Grid.Row="1" Margin="28,24,28,24">
                <!-- 环境服务 -->
                <Grid Visibility="{Binding EnvironmentPageVisibility}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="0" /><RowDefinition Height="0" /></Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16">
                                <StackPanel>
                                    <TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,0,14" Text="本机启动 MQTT Broker，用于联调和离线测试。" />
                                    <Border Height="480" Background="Transparent" BorderThickness="0" Padding="0">
                                        <StackPanel>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock FontSize="17" FontWeight="SemiBold" Text="本地 MQTT" /><Border Grid.Column="1" Background="{StaticResource GreenSoftBrush}" CornerRadius="9" Padding="8,3"><TextBlock Foreground="{StaticResource GreenBrush}" FontSize="11" Text="{Binding EmbeddedBrokerStatus}" /></Border></Grid>
                                            <TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,14" Text="本机作为 MQTT 服务端；客户端连接本地服务时直接复用以下配置。" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="监听地址" /><TextBlock FontFamily="Cascadia Mono" Margin="0,5,0,0" Text="127.0.0.1（本机）" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="监听端口" /><TextBox Margin="0,5,0,0" Text="{Binding LocalBrokerPort, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="服务端用户名（可选）" /><TextBox Margin="0,5,0,0" Text="{Binding LocalBrokerUserName, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="服务端密码（仅保存到 Credential Manager）" /><controls:PasswordInput Margin="0,5,0,0" Password="{Binding LocalBrokerPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" HorizontalAlignment="Left" Content="{Binding EmbeddedBrokerToggleText}" Command="{Binding ToggleEmbeddedBrokerCommand}" />
                                            <Button Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" HorizontalAlignment="Left" Content="{Binding LocalMqttConnectionToggleText}" Command="{Binding ToggleLocalMqttConnectionCommand}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Height="236" Background="#F5F8FC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,16,0,0" Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock FontSize="17" FontWeight="SemiBold" Text="本地 HTTP Range 服务" /><Border Grid.Column="1" Background="{StaticResource GreenSoftBrush}" CornerRadius="9" Padding="8,3"><TextBlock Foreground="{StaticResource GreenBrush}" FontSize="11" Text="{Binding HttpServiceStatus}" /></Border></Grid>
                                            <TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,14" Text="本机提供 Patch 文件的 HEAD、GET 和 Range GET 服务。" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="监听端口" /><TextBox Margin="0,5,0,0" Text="{Binding HttpPort, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="本地服务地址" /><TextBlock FontFamily="Cascadia Mono" Foreground="{StaticResource GreenBrush}" Margin="0,5,0,0" Text="{Binding HttpServiceAddress}" />
                                            <Button Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" HorizontalAlignment="Left" Content="{Binding HttpServiceToggleText}" Command="{Binding ToggleHttpServiceCommand}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock FontSize="17" FontWeight="SemiBold" Text="本地 HTTP Range 服务" /><Border Grid.Column="1" Background="{StaticResource GreenSoftBrush}" CornerRadius="9" Padding="8,3"><TextBlock Foreground="{StaticResource GreenBrush}" FontSize="11" Text="{Binding HttpServiceStatus}" /></Border></Grid>
                                    <TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,14" Text="本机提供 Patch 文件的 HEAD、GET 和 Range GET 服务。" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="监听端口" /><TextBox Margin="0,5,0,0" Text="{Binding HttpPort, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="本地服务地址" /><TextBlock FontFamily="Cascadia Mono" Foreground="{StaticResource GreenBrush}" Margin="0,5,0,0" Text="{Binding HttpServiceAddress}" />
                                    <Button Style="{StaticResource PrimaryButton}" Foreground="White" Margin="0,16,0,0" HorizontalAlignment="Left" Content="{Binding HttpServiceToggleText}" Command="{Binding ToggleHttpServiceCommand}" />
                                    <Border Background="#E9F0FF" BorderBrush="#BDD1FF" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,12,0,0"><StackPanel><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" Text="当前 OTA 下载地址" /><TextBlock FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource BlueBrush}" Margin="0,5,0,0" Text="{Binding SelectedHttpPatchUrl}" TextWrapping="Wrap" /></StackPanel></Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="0" Grid.Column="2" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="0" /><RowDefinition Height="0" /></Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16">
                                <StackPanel>
                                    <TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,0,14" Text="连接外部 MQTT Broker，用于真实 OTA 验证。" />
                                    <Border Height="480" Background="Transparent" BorderThickness="0" Padding="0">
                                        <StackPanel>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock FontSize="17" FontWeight="SemiBold" Text="公网 MQTT" /><Border Grid.Column="1" Background="{StaticResource GreenSoftBrush}" CornerRadius="9" Padding="8,3"><TextBlock Foreground="{StaticResource GreenBrush}" FontSize="11" Text="{Binding MqttStatus}" /></Border></Grid>
                                            <TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,14" Text="配置并连接公网或外部 MQTT Broker。切换前请先断开当前客户端连接。" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="公网 / 外部 Broker 地址" /><TextBox Margin="0,5,0,0" Text="{Binding MqttHost, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="公网端口" /><TextBox Margin="0,5,0,0" Text="{Binding MqttPort, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="客户端用户名" /><TextBox Margin="0,5,0,0" Text="{Binding MqttUserName, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="公网客户端密码" /><controls:PasswordInput Margin="0,5,0,0" Password="{Binding MqttPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <StackPanel Margin="0,12,0,0">
                                                <CheckBox Content="公网连接使用 TLS" IsChecked="{Binding MqttUseTls}" />
                                                <CheckBox Margin="0,8,0,0" Content="允许不受信任证书（仅测试）" IsChecked="{Binding MqttAcceptAnyServerCertificate}" />
                                            </StackPanel>
                                            <Button Style="{StaticResource PrimaryButton}" Margin="0,51,0,0" HorizontalAlignment="Left" Content="{Binding PublicMqttConnectionToggleText}" Command="{Binding TogglePublicMqttConnectionCommand}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Height="236" Background="#F5F8FC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,16,0,0" Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock FontSize="17" FontWeight="SemiBold" Text="公网 HTTP 文件服务" /><Border Grid.Column="1" Background="{StaticResource BlueSoftBrush}" CornerRadius="9" Padding="8,3"><TextBlock Foreground="{StaticResource BlueBrush}" FontSize="11" Text="{Binding PublicHttpServiceStatus}" /></Border></Grid>
                                            <TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,14" Text="填写已部署 Patch 文件的公网 HTTP 基地址。" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="公网 HTTP 基地址" /><TextBox Margin="0,5,0,0" Text="{Binding PublicHttpBaseUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如：https://example.com/ota/" />
                                            <Button Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" HorizontalAlignment="Left" Content="设置公网服务" Command="{Binding ApplyPublicHttpServerCommand}" />
                                            <TextBlock FontSize="11" Foreground="{StaticResource MutedInkBrush}" Margin="0,7,0,0" Text="本地 HTTP 服务运行时不能设置公网服务。" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock FontSize="17" FontWeight="SemiBold" Text="公网 HTTP 文件服务" /><Border Grid.Column="1" Background="{StaticResource BlueSoftBrush}" CornerRadius="9" Padding="8,3"><TextBlock Foreground="{StaticResource BlueBrush}" FontSize="11" Text="公网来源" /></Border></Grid>
                                    <TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,14" Text="填写已部署 Patch 文件的公网 HTTP 基地址；切换前请先停止本地 HTTP 服务。" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="公网 HTTP 基地址" /><TextBox Margin="0,5,0,0" Text="{Binding PublicHttpBaseUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如：https://example.com/ota/" />
                                    <Button Style="{StaticResource PrimaryButton}" Foreground="White" Margin="0,12,0,0" HorizontalAlignment="Left" Content="设置公网服务" Command="{Binding ApplyPublicHttpServerCommand}" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource MutedInkBrush}" Margin="0,7,0,0" Text="设置时会校验地址格式并保存。发布当前 Patch 成功后也会自动填充。" TextWrapping="Wrap" />
                                    <Border Background="#E9F0FF" BorderBrush="#BDD1FF" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,12,0,0"><StackPanel><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" Text="当前 OTA 下载地址" /><TextBlock FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource BlueBrush}" Margin="0,5,0,0" Text="{Binding SelectedHttpPatchUrl}" TextWrapping="Wrap" /></StackPanel></Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Grid.ColumnSpan="3" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock FontSize="17" FontWeight="SemiBold" Text="本地 HTTP Range 服务" /><Border Grid.Column="1" Background="{StaticResource GreenSoftBrush}" CornerRadius="9" Padding="8,3"><TextBlock Foreground="{StaticResource GreenBrush}" FontSize="11" Text="{Binding HttpServiceStatus}" /></Border></Grid>
                                    <TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,14" Text="本机提供 Patch 文件的 HEAD、GET 和 Range GET 服务。" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="监听端口" /><TextBox Margin="0,5,0,0" Text="{Binding HttpPort, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="本地服务地址" /><TextBlock FontFamily="Cascadia Mono" Foreground="{StaticResource GreenBrush}" Margin="0,5,0,0" Text="{Binding HttpServiceAddress}" />
                                    <Button Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" HorizontalAlignment="Left" Content="{Binding HttpServiceToggleText}" Command="{Binding ToggleHttpServiceCommand}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock FontSize="17" FontWeight="SemiBold" Text="公网 HTTP 文件服务" /><Border Grid.Column="1" Background="{StaticResource BlueSoftBrush}" CornerRadius="9" Padding="8,3"><TextBlock Foreground="{StaticResource BlueBrush}" FontSize="11" Text="{Binding PublicHttpServiceStatus}" /></Border></Grid>
                                    <TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,14" Text="填写已部署 Patch 文件的公网 HTTP 基地址。" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="公网 HTTP 基地址" /><TextBox Margin="0,5,0,0" Text="{Binding PublicHttpBaseUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如：https://example.com/ota/" />
                                    <Button Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" HorizontalAlignment="Left" Content="设置公网服务" Command="{Binding ApplyPublicHttpServerCommand}" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource MutedInkBrush}" Margin="0,7,0,0" Text="本地 HTTP 服务运行时不能设置公网服务。" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Margin="16,14,16,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock FontSize="17" FontWeight="SemiBold" Text="MQTT 收发记录" /><TextBlock FontSize="11" Foreground="{StaticResource MutedInkBrush}" Margin="0,3,0,0" Text="滚轮暂停自动跟随，按 Enter 回到最新消息。二进制载荷以 HEX 安全显示。" /></StackPanel>
                                    <TextBox Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0" Text="{Binding MqttMessageFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="按 Topic 或内容过滤" />
                                    <Button Grid.Column="2" Style="{StaticResource QuietButton}" VerticalAlignment="Center" Content="清理" Command="{Binding ClearMqttMessagesCommand}" />
                                </Grid>
                                <ScrollViewer x:Name="LegacyMqttMessagesScrollViewer" Grid.Row="1" Margin="16,0,16,14" Background="#F8FAFD" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True">
                                    <ItemsControl ItemsSource="{Binding VisibleMqttMessages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="MessageBubble" Margin="8" Padding="10,8" MaxWidth="760" HorizontalAlignment="Left" Background="White" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="6">
                                                    <Border.Style>
                                                        <Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsOutgoing}" Value="True"><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="Background" Value="#E9F0FF" /><Setter Property="BorderBrush" Value="#BDD1FF" /></DataTrigger></Style.Triggers></Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Left" FontFamily="Cascadia Mono" FontSize="11" FontWeight="SemiBold"><Run Text="{Binding Time, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Direction, Mode=OneWay}" /></TextBlock><TextBlock DockPanel.Dock="Right" FontSize="10" Foreground="{StaticResource MutedInkBrush}" Text="{Binding PayloadKind}" /><TextBlock FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource BlueBrush}" Text="{Binding Topic}" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" /></DockPanel>
                                                        <TextBox Margin="0,7,0,0" Padding="0" BorderThickness="0" Background="Transparent" FontFamily="Cascadia Mono" FontSize="11" Foreground="#28384F" IsReadOnly="True" Text="{Binding Payload, Mode=OneWay}" TextWrapping="Wrap" AcceptsReturn="True" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid MinHeight="440">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Border Margin="16,16,16,0" Background="#EEF2F8" CornerRadius="6" Padding="3" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton GroupName="MqttConfigurationTabs" Style="{StaticResource ModeRadio}" Content="公网 MQTT"
                                                             IsChecked="{Binding MqttClientUsesExternalBroker, Mode=OneWay}"
                                                             Command="{Binding SelectMqttConfigurationCommand}" CommandParameter="External" />
                                                <RadioButton GroupName="MqttConfigurationTabs" Style="{StaticResource ModeRadio}" Content="本地 MQTT"
                                                             IsChecked="{Binding MqttClientUsesLocalBroker, Mode=OneWay}"
                                                             Command="{Binding SelectMqttConfigurationCommand}" CommandParameter="Local" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="PublicMqttBrokerPanel" Grid.Row="1" Margin="16" Style="{StaticResource FunctionalPanel}" Visibility="{Binding MqttExternalConfigurationVisibility}">
                                            <StackPanel>
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource FunctionalPanelTitle}" Text="公网 MQTT Broker" /><Border Grid.Column="1" Background="{StaticResource GreenSoftBrush}" CornerRadius="9" Padding="8,3"><TextBlock Foreground="{StaticResource GreenBrush}" FontSize="11" Text="{Binding MqttStatus}" /></Border></Grid>
                                                <TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,5,0,16" Text="配置并连接公网或外部 MQTT Broker。切换前请先断开当前客户端连接。" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="公网 / 外部 Broker 地址" /><TextBox Margin="0,5,0,0" Text="{Binding MqttHost, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="公网端口" /><TextBox Margin="0,5,0,0" Text="{Binding MqttPort, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="客户端用户名" /><TextBox Margin="0,5,0,0" Text="{Binding MqttUserName, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="公网客户端密码" /><controls:PasswordInput Margin="0,5,0,0" Password="{Binding MqttPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel Margin="0,14,0,0" Orientation="Horizontal"><CheckBox Content="公网连接使用 TLS" IsChecked="{Binding MqttUseTls}" /><CheckBox Margin="18,0,0,0" Content="允许不受信任证书（仅测试）" IsChecked="{Binding MqttAcceptAnyServerCertificate}" /></StackPanel>
                                                <Button Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" HorizontalAlignment="Left" Content="{Binding PublicMqttConnectionToggleText}" Command="{Binding TogglePublicMqttConnectionCommand}" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="LocalMqttBrokerPanel" Grid.Row="1" Margin="16" Style="{StaticResource FunctionalPanel}" Visibility="{Binding MqttLocalConfigurationVisibility}">
                                            <StackPanel>
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource FunctionalPanelTitle}" Text="本地 MQTT Broker" /><Border Grid.Column="1" Background="{StaticResource GreenSoftBrush}" CornerRadius="9" Padding="8,3"><TextBlock Foreground="{StaticResource GreenBrush}" FontSize="11" Text="{Binding EmbeddedBrokerStatus}" /></Border></Grid>
                                                <TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,5,0,16" Text="本机作为 MQTT 服务端。启动 Broker 不会自动连接工具客户端，请点击下方按钮连接本地 Broker。" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="监听地址" /><TextBlock FontFamily="Cascadia Mono" Margin="0,5,0,0" Text="127.0.0.1（本机）" />
                                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="监听端口" /><TextBox Margin="0,5,0,0" Text="{Binding LocalBrokerPort, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="服务端用户名（可选）" /><TextBox Margin="0,5,0,0" Text="{Binding LocalBrokerUserName, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="服务端密码（仅保存到 Credential Manager）" /><controls:PasswordInput Margin="0,5,0,0" Password="{Binding LocalBrokerPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Style="{StaticResource PrimaryButton}" Content="{Binding EmbeddedBrokerToggleText}" Command="{Binding ToggleEmbeddedBrokerCommand}" /><Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{Binding LocalMqttConnectionToggleText}" Command="{Binding ToggleLocalMqttConnectionCommand}" /></StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Border x:Name="MqttTopicPanel" Grid.Row="1" Margin="16,8,16,16" Style="{StaticResource FunctionalPanel}">
                                        <StackPanel>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource FunctionalPanelTitle}" Text="主题配置" /><Border Grid.Column="1" Background="{Binding GatewaySubscriptionBadgeBackground}" CornerRadius="9" Padding="8,3"><TextBlock Foreground="{Binding GatewaySubscriptionBadgeForeground}" FontSize="11" Text="{Binding GatewaySubscriptionBadgeText}" /></Border></Grid>
                                            <TextBlock FontSize="11" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,10" Text="主题格式固定；配置 Gateway ID 后订阅其上行消息。升级任务直接使用此 ID。" TextWrapping="Wrap" />
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Text="Gateway dev ID（十进制）" /><ComboBox Grid.Column="2" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding GatewayIdHistory}" Text="{Binding GatewayId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="可直接输入或选择最近使用的 Gateway dev ID" /><Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Padding="12,5" Content="订阅主题" Command="{Binding SubscribeGatewayTopicCommand}" /></Grid>
                                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,8,0,0" Text="订阅主题（上行）" /><TextBlock FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource BlueBrush}" Margin="0,3,0,0" Text="{Binding GatewaySubscriptionTopic}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,7,0,0" Text="发布主题（下行）" /><TextBlock FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource BlueBrush}" Margin="0,3,0,0" Text="{Binding GatewayPublishTopic}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                </ScrollViewer>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Grid Margin="16,14,16,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="17" FontWeight="SemiBold" Text="MQTT 收发记录" /><TextBlock FontSize="11" Foreground="{StaticResource MutedInkBrush}" Margin="0,3,0,0" Text="滚轮暂停自动跟随，按 Enter 回到最新消息。载荷按原始内容显示。" /></StackPanel><TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource MutedInkBrush}" Text="过滤" ToolTip="按 Topic 或载荷内容过滤" /><TextBox Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding MqttMessageFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入 Topic 或载荷内容，实时过滤收发记录" /><Button Grid.Column="3" Style="{StaticResource QuietButton}" VerticalAlignment="Center" Content="清理" Command="{Binding ClearMqttMessagesCommand}" /></Grid>
                                    <ScrollViewer x:Name="MqttMessagesScrollViewer" Grid.Row="1" Margin="16,0,16,14" Background="#F8FAFD" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True" PreviewMouseWheel="OnMqttMessagesPreviewMouseWheel" PreviewKeyDown="OnMqttMessagesPreviewKeyDown" Loaded="OnMqttMessagesLoaded"><ItemsControl ItemsSource="{Binding VisibleMqttMessages}"><ItemsControl.ItemTemplate><DataTemplate><Grid HorizontalAlignment="Stretch"><Border Margin="8" Padding="10,8" MaxWidth="760" HorizontalAlignment="Left" Background="White" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="6"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsOutgoing}" Value="True"><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="Background" Value="#E9F0FF" /><Setter Property="BorderBrush" Value="#BDD1FF" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Left" FontFamily="Cascadia Mono" FontSize="11" FontWeight="SemiBold"><Run Text="{Binding Time, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Direction, Mode=OneWay}" /></TextBlock><TextBlock FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource BlueBrush}" Text="{Binding Topic}" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" /></DockPanel><TextBox Margin="0,7,0,0" Padding="0" BorderThickness="0" Background="Transparent" FontFamily="Cascadia Mono" FontSize="11" Foreground="#28384F" IsReadOnly="True" Text="{Binding Payload, Mode=OneWay}" TextWrapping="Wrap" AcceptsReturn="True" /></StackPanel></Border></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- PATCH 中心 -->
                <views:PatchPage Visibility="{Binding PatchPageVisibility}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock FontSize="18" FontWeight="SemiBold" Text="Patch 导入" /><Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="导入 Patch" Command="{Binding SelectPatchCommand}" /></Grid>
                                <TextBlock FontFamily="Cascadia Mono" FontSize="14" Margin="0,22,0,0" Text="{Binding PatchFileName}" /><TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,8,0,0" Text="{Binding PatchDetail}" TextWrapping="Wrap" /><TextBlock FontSize="12" Foreground="{StaticResource GreenBrush}" Margin="0,10,0,0" Text="{Binding PatchStatus}" TextWrapping="Wrap" />
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="差分引擎安全门禁" /><TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,8,0,0" Text="{Binding DiffEngineStatus}" TextWrapping="Wrap" /><Border Background="#FFF6E7" BorderBrush="#F1D7A4" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,16,0,0"><TextBlock FontSize="12" Foreground="{StaticResource AmberBrush}" Text="未通过黄金样本与真实 Bootloader 验证前，工具仅允许导入外部 Patch。" TextWrapping="Wrap" /></Border></StackPanel></Border>
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="SFTP 公网发布" /><TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,16" Text="上传采用临时文件与原子重命名，并在发布后完整下载校验 MD5。" TextWrapping="Wrap" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource FieldLabel}" Text="SFTP 主机" /><TextBox Margin="0,6,0,0" Text="{Binding SftpHost, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Style="{StaticResource FieldLabel}" Text="端口" /><TextBox Margin="0,6,0,0" Text="{Binding SftpPort, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="用户名" /><TextBox Margin="0,6,0,0" Text="{Binding SftpUserName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="密码 / OpenSSH 私钥路径" /><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBox Margin="0,0,8,0" Text="{Binding SftpPassword, UpdateSourceTrigger=PropertyChanged}" ToolTip="密码" /><TextBox Grid.Column="1" Text="{Binding SftpPrivateKeyPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="私钥路径" /></Grid>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="远端目录 / 公网 HTTP 基地址" /><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBox Margin="0,0,8,0" Text="{Binding SftpRemoteDirectory, UpdateSourceTrigger=PropertyChanged}" /><TextBox Grid.Column="1" Text="{Binding SftpPublicBaseUrl, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="Host Key SHA256" /><TextBox Margin="0,6,0,0" Text="{Binding SftpHostKeySha256, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" HorizontalAlignment="Left" Content="发布当前 Patch" Command="{Binding PublishPatchCommand}" /><TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,10,0,0" Text="{Binding PublishStatus, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel></Border>
                    </Grid>
                </ScrollViewer>

                <!-- 升级任务 -->
                <Grid Visibility="{Binding TaskPageVisibility}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TaskConfigurationColumn" Width="*" />
                        <ColumnDefinition x:Name="TaskLayoutGutterColumn" Width="16" />
                        <ColumnDefinition x:Name="TaskStatusColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CompactTaskViewSelector"
                            Grid.Row="0"
                            Grid.ColumnSpan="3"
                            Margin="0,0,0,10"
                            Padding="3"
                            HorizontalAlignment="Left"
                            Background="#E8EDF5"
                            CornerRadius="6"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="CompactTaskConfigurationOption"
                                         GroupName="CompactTaskView"
                                         IsChecked="True"
                                         Style="{StaticResource ModeRadio}"
                                         Content="任务配置"
                                         Checked="OnCompactTaskConfigurationChecked" />
                            <RadioButton x:Name="CompactTaskStatusOption"
                                         GroupName="CompactTaskView"
                                         Style="{StaticResource ModeRadio}"
                                         Content="升级状态"
                                         Checked="OnCompactTaskStatusChecked" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer x:Name="TaskConfigurationScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <Border x:Name="UpgradeTaskConfigurationPanel" Style="{StaticResource FunctionalPanel}">
                            <StackPanel>
                            <Grid><StackPanel><TextBlock Style="{StaticResource FunctionalPanelTitle}" Text="升级任务配置" /><TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}" Margin="0,4,0,0" Text="配置升级类型、版本和 Patch 后加入下方队列；所有任务均按顺序执行并自动闭环。" TextWrapping="Wrap" /></StackPanel></Grid>
                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource FieldLabel}" Text="升级类型" /><ComboBox ItemsSource="{Binding TaskTypes}" SelectedItem="{Binding SelectedTaskType}" Margin="0,6,0,0" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Style="{StaticResource FieldLabel}" Text="旧版本" /><Border Margin="0,6,0,0" Style="{StaticResource ReadOnlyValue}" ToolTip="由所选 Patch 自动识别"><TextBlock VerticalAlignment="Center" Text="{Binding OldVersionDisplay, Mode=OneWay}" /></Border></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="新版本" /><Border Margin="0,6,0,0" Style="{StaticResource ReadOnlyValue}" ToolTip="由所选 Patch 自动识别"><TextBlock VerticalAlignment="Center" Text="{Binding NewVersionDisplay, Mode=OneWay}" /></Border></StackPanel>
                            </Grid>
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding TargetScopeVisibility}"><TextBlock Style="{StaticResource FieldLabel}" Text="目标范围" /><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><RadioButton GroupName="Target" IsChecked="{Binding IsSpecifiedTarget, Mode=TwoWay}" Content="指定 ID" Margin="0,0,18,0" /><RadioButton GroupName="Target" IsChecked="{Binding IsBroadcastTarget, Mode=TwoWay}" Content="广播" /></StackPanel></StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,0" Text="正向升级 Patch" />
                            <ComboBox Margin="0,6,0,0" ItemsSource="{Binding UpgradePatchChoices}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedUpgradePatch, Mode=TwoWay}" />
                            <TextBlock FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource MutedInkBrush}" Margin="0,5,0,0" Text="{Binding SelectedUpgradePatchSummary}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,0" Text="反向升级 Patch" />
                            <ComboBox Margin="0,6,0,0" ItemsSource="{Binding ReverseUpgradePatchChoices}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedReverseUpgradePatch, Mode=TwoWay}" />
                            <TextBlock FontSize="11" Foreground="{StaticResource MutedInkBrush}" Margin="0,5,0,0" Text="{Binding ReversePatchStatus}" TextWrapping="Wrap" />
                            <TextBlock FontSize="11" Foreground="{StaticResource MutedInkBrush}" Margin="0,8,0,0" Text="{Binding GatewayIdTaskHint}" TextWrapping="Wrap" />
                            <Border Margin="0,10,0,0" Padding="10" Background="#F8FAFD" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Visibility="{Binding ExtenderSelectionVisibility}">
                                <StackPanel>
                                    <WrapPanel>
                                        <Button MinWidth="112" Style="{StaticResource QuietButton}" Content="{Binding DeviceDiscoveryButtonText}" Command="{Binding RefreshExtendersCommand}" IsEnabled="{Binding CanRefreshDiscovery}" Margin="0,0,8,0" />
                                        <Button Style="{StaticResource QuietButton}" Content="{Binding ExtenderSelectionToggleText}" Command="{Binding ToggleExtenderSelectionCommand}" Visibility="{Binding ExtenderTargetListVisibility}" />
                                    </WrapPanel>
                                    <TextBlock Margin="0,6,0,8" FontSize="11" Foreground="{StaticResource MutedInkBrush}" Text="{Binding DeviceDiscoveryStatus}" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding DiscoveredExtenders}" Visibility="{Binding ExtenderTargetListVisibility}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Background="White" BorderBrush="#D8E2EF" BorderThickness="1" CornerRadius="6">
                                                    <Grid>
                                                        <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource BlueBrush}" CornerRadius="6,0,0,6" />
                                                        <StackPanel Margin="12,10,10,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock FontSize="10" Foreground="{StaticResource MutedInkBrush}" Text="EXTENDER" VerticalAlignment="Center" />
                                                                        <TextBlock Margin="7,0,0,0" FontFamily="Cascadia Mono" FontSize="13" FontWeight="SemiBold" Text="{Binding ExtenderIdDisplay}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </CheckBox>
                                                                <Border Grid.Column="1" Padding="8,3" Background="{StaticResource GreenSoftBrush}" CornerRadius="10">
                                                                    <TextBlock FontSize="10" Foreground="{StaticResource GreenBrush}" Text="{Binding NodeCountDisplay}" />
                                                                </Border>
                                                            </Grid>
                                                            <WrapPanel Margin="22,8,0,0">
                                                                <Border Margin="0,0,6,6" Padding="8,5" Background="#F4F7FB" CornerRadius="4">
                                                                    <StackPanel><TextBlock FontSize="9" Foreground="{StaticResource MutedInkBrush}" Text="同步版本" /><TextBlock Margin="0,2,0,0" FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource BlueBrush}" Text="{Binding SyncVersionDisplay}" /></StackPanel>
                                                                </Border>
                                                                <Border Margin="0,0,6,6" Padding="8,5" Background="#F4F7FB" CornerRadius="4">
                                                                    <StackPanel><TextBlock FontSize="9" Foreground="{StaticResource MutedInkBrush}" Text="异步版本" /><TextBlock Margin="0,2,0,0" FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource BlueBrush}" Text="{Binding AsyncVersionDisplay}" /></StackPanel>
                                                                </Border>
                                                                <Border Margin="0,0,6,6" Padding="8,5" Background="#F4F7FB" CornerRadius="4">
                                                                    <StackPanel><TextBlock FontSize="9" Foreground="{StaticResource MutedInkBrush}" Text="Async 地址" /><TextBlock Margin="0,2,0,0" FontFamily="Cascadia Mono" FontSize="11" Text="{Binding AsyncAddressDisplay}" /></StackPanel>
                                                                </Border>
                                                                <Border Margin="0,0,6,6" Padding="8,5" Background="#F4F7FB" CornerRadius="4">
                                                                    <StackPanel><TextBlock FontSize="9" Foreground="{StaticResource MutedInkBrush}" Text="Sync 信号" /><TextBlock Margin="0,2,0,0" FontFamily="Cascadia Mono" FontSize="11" Text="{Binding SyncSignalDisplay}" /></StackPanel>
                                                                </Border>
                                                            </WrapPanel>
                                                            <Grid Margin="22,1,0,0">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                <TextBlock FontSize="9" Foreground="{StaticResource MutedInkBrush}" Text="鉴权详情" />
                                                                <TextBlock Grid.Column="1" Margin="8,0,0,0" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource MutedInkBrush}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding NodeDiscoveryVisibility}">
                                <Border Padding="10" Background="#F8FAFD" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="批量选择 Node 类型" />
                                                <ComboBox Margin="0,5,0,0" ItemsSource="{Binding NodeTypeOptions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedNodeTypeOption, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="筛选 Node ID" />
                                                <TextBox Margin="0,5,0,0" ToolTip="输入完整或部分 Node ID；筛选只影响列表显示" Text="{Binding NodeIdSearch, UpdateSourceTrigger=PropertyChanged}" />
