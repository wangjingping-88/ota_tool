                                                            <TextBlock Grid.Column="2" Margin="0,0,10,0" Text="{Binding LocalStartTime}" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="3" Margin="0,0,10,0" Foreground="{StaticResource MutedInkBrush}" Text="{Binding Direction}" TextWrapping="Wrap" />
