                                                                    <TextBlock Grid.Column="1" FontFamily="Cascadia Mono"><Run Text="{Binding NodeIdDisplay, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding NodeTypeDisplay, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SoftwareVersionDisplay, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Rssi, Mode=OneWay}" /><Run Text=" dBm" /></TextBlock>
                                                                    <TextBlock Grid.Column="2" Margin="12,0,0,0" FontWeight="SemiBold" Foreground="{Binding OnlineStatusForeground, Mode=OneWay}" Text="{Binding OnlineStatusText, Mode=OneWay}" />
