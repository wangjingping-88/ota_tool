                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Expander Margin="0,14,0,0" Header="高级：手动目标兜底" Visibility="{Binding SpecifiedTargetVisibility}"><StackPanel Margin="0,8,0,0"><TextBlock Style="{StaticResource FieldLabel}" Text="目标 ID（十进制，每行一个）" /><TextBox Margin="0,6,0,0" Height="92" AcceptsReturn="True" Text="{Binding TargetIdList, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Expander>
