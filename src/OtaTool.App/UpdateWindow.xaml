<Window x:Class="OtaTool.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OTA 测试平台更新"
        Width="680" Height="570" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" Text="正式版更新" />
            <TextBlock Margin="0,5,0,0" FontSize="24" FontWeight="SemiBold" Text="{Binding VersionTitle}" />
            <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource MutedInkBrush}" Text="{Binding VersionSummary}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,14" Padding="14,10" CornerRadius="6" Background="{StaticResource BlueSoftBrush}">
            <TextBlock Foreground="#204D9B" Text="更新包将先完成大小与双重 SHA-256 校验，再切换程序目录；新版启动失败时会自动回滚。" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="更新说明" />
                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock FontSize="13" LineHeight="22" Text="{Binding ReleaseNotes}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Visibility="{Binding ProgressVisibility}" />
            <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource MutedInkBrush}" Text="{Binding Status}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource QuietButton}" Content="打开 Release" Click="OnOpenReleaseClick" IsEnabled="{Binding IsIdle}" />
            <Button Grid.Column="2" Margin="0,0,8,0" Padding="18,9" Content="稍后" Click="OnLaterClick" IsEnabled="{Binding IsIdle}" />
            <Button Grid.Column="3" MinWidth="132" Style="{StaticResource PrimaryButton}" Content="{Binding InstallButtonText}" Click="OnInstallClick" IsEnabled="{Binding CanInstall}" />
        </Grid>
    </Grid>
</Window>
