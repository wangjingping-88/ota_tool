<UserControl x:Class="OtaTool.App.Controls.PasswordInput"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="EyeButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ToolTip" Value="显示密码" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4">
                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M2,12 C5.5,6.5 8.8,5 12,5 C15.2,5 18.5,6.5 22,12 C18.5,17.5 15.2,19 12,19 C8.8,19 5.5,17.5 2,12 Z"
                                          Stroke="#657287" StrokeThickness="1.8" StrokeLineJoin="Round" />
                                    <Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6" Stroke="#657287" StrokeThickness="1.8" />
                                    <Path x:Name="EyeSlash" Data="M4,4 L20,20" Stroke="#657287" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E9F0FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D6E5FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="36" />
        </Grid.ColumnDefinitions>
        <PasswordBox x:Name="PasswordEditor"
                     Margin="0,0,7,0"
                     PasswordChanged="OnPasswordChanged" />
        <TextBox x:Name="PlainTextEditor"
                 Margin="0,0,7,0"
                 Text="{Binding Password, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="Collapsed" />
        <Button x:Name="ToggleButton"
                Grid.Column="1"
                Style="{StaticResource EyeButton}"
                Click="OnTogglePassword" />
    </Grid>
</UserControl>
