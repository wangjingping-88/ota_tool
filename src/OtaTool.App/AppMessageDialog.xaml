<Window x:Class="OtaTool.App.AppMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True">
    <Border Margin="14"
            Padding="22"
            Background="White"
            BorderBrush="#D7E0EA"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.22" ShadowDepth="4" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#0B1B2E"
                           Text="{Binding DialogTitle}" />
                <Button Grid.Column="1"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="18"
                        Foreground="#65758B"
                        Content="×"
                        Click="OnConfirmClick" />
            </Grid>
            <TextBlock Grid.Row="1"
                       Margin="0,16,0,20"
                       FontSize="13"
                       Foreground="#26364A"
                       Text="{Binding DialogMessage}"
                       TextWrapping="Wrap" />
            <Button Grid.Row="2"
                    MinWidth="82"
                    Height="34"
                    Padding="16,0"
                    HorizontalAlignment="Right"
                    Background="#276EF1"
                    BorderBrush="#276EF1"
                    BorderThickness="1"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Content="确定"
                    IsDefault="True"
                    Click="OnConfirmClick" />
        </Grid>
    </Border>
</Window>
